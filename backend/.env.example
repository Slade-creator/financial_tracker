OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=qwen/qwen3-vl-30b-a3b-thinking
# Public URL of your deployed app, sent to OpenRouter as HTTP-Referer.
# Optional — leave empty to omit the header (fine for local development).
HTTP_REFERER=
DEBUG=False

# Host/port used only when running `python main.py` directly.
HOST=0.0.0.0
PORT=8000
REPORTS_DIR=reports

# CORS: JSON array of origins allowed to call this API from a browser.
# Must be a JSON array (quotes required). Examples:
#   ALLOWED_ORIGINS=["http://localhost:5173", "http://10.0.2.2:8000"]
# Use ["*"] only for local development — it serves CORS without credentials.
# Leave unset for no cross-origin browser access.
ALLOWED_ORIGINS=[]
